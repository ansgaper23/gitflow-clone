# Servidor
PORT=8787
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
FRONTEND_URL=http://localhost:5173

# Supabase (Project Settings > API en supabase.com)
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub OAuth App (github.com/settings/developers)
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:8787/api/auth/github/callback
# GITHUB_CLIENT_ID=tu-github-client-id
# GITHUB_CLIENT_SECRET=tu-github-client-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Supabase OAuth App (botón "Conectar con Supabase" de 1 clic, opcional)
# Organization Settings -> OAuth Apps -> Add application, en supabase.com
# Redirect URI: http://localhost:8787/api/auth/supabase/callback
# Scopes mínimos: Projects: Read, Database: Write
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=

# Las API keys de los proveedores de IA (Anthropic, Gemini) ya NO van aquí.
# Se gestionan desde el panel /admin de la propia app (tabla ai_accounts).

# Servicio de vista previa (opcional, ver infra/preview-orchestrator/)
# PREVIEW_ORCHESTRATOR_URL=http://IP_DE_TU_VPS:4000
# PREVIEW_ORCHESTRATOR_SECRET=el-mismo-ORCH_SECRET-del-orquestador
PREVIEW_ORCHESTRATOR_URL=
PREVIEW_ORCHESTRATOR_SECRET=

# Pago manual por Yape/Plin (opcional). No hay API de cobro sin cuenta de negocio: esto solo
# muestra tu número (y el QR "Mi QR" que exportás desde la app Yape, si subís uno) en el
# checkout; el pago se confirma a mano desde /admin (ver Ventas). Si YAPE_PLIN_PHONE queda
# vacío, esta opción de pago no se muestra.
# YAPE_PLIN_PHONE=999888777
# YAPE_PLIN_QR_URL=https://flow-pro.online/yape-qr.png
# USD_PEN_RATE=3.75
